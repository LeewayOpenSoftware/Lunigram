<local:HostedPage x:Class="Telegram.Views.Settings.SettingsBackgroundsPage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:common="using:Telegram.Common"
                  xmlns:controls="using:Telegram.Controls"
                  xmlns:chats="using:Telegram.Controls.Chats"
                  xmlns:local="using:Telegram.Views"
                  xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:not_win="http://uno.ui/not_win"
                  mc:Ignorable="d not_win">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <SlideNavigationTransitionInfo Effect="FromRight" />
            </NavigationThemeTransition>
        </TransitionCollection>
    </Page.Transitions>

    <Grid Background="{ThemeResource SettingsPageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--
            HeaderHost/FooterHost: where this page's real GridView.Header/Footer move to on Linux.
            Empty and therefore zero-high on Windows, where Header/Footer stay the list's own and
            nothing changes. Telegram.Linux/Xaml/DrawerHeaderHost.cs (SettingsBackgroundsPage.xaml.cs
            for the Footer, which has real content, a "Reset chat backgrounds" button, not a bare
            spacer) says why they cannot stay stacked beside a horizontal wrap grid on Uno.
        -->
        <Border x:Name="HeaderHost"
                Grid.Row="0" />
        <GridView x:Name="ScrollingHost"
                  ItemsSource="{x:Bind ViewModel.Items}"
                  ItemClick="List_ItemClick"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  ChoosingItemContainer="OnChoosingItemContainer"
                  ContainerContentChanging="OnContainerContentChanging"
                  common:FluidGridView.MaxLength="1008"
                  Padding="20,0"
                  Grid.Row="1">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--
                        ItemsWrapGrid is [NotImplemented] on Uno Skia (no Measure/Arrange at all),
                        so it measures no width and the grid renders empty. VariableSizedWrapGrid is
                        the proven substitute (profile Media/Gifts/Animations tabs, CommonStyles'
                        implicit default). It does not virtualize.
                    -->
                    <win:ItemsWrapGrid Orientation="Horizontal"
                                       MaxWidth="1008" />
                    <!--
                        ItemWidth/ItemHeight are load-bearing, not decoration. Uno's
                        VariableSizedWrapGrid.ComputeBounds falls back PER AXIS to child 0's
                        DesiredSize when they are unset (both default to NaN), and
                        CalculateOccupancyMap then divides the available space by that cell size to
                        get itemsPerLine. The tile here is an AspectView with no Constraint, so it
                        desires whatever its children happen to want and the row count follows from
                        that instead of from the layout - which is the sparse floating rows.
                        Seeding both axes fixes the cell, so itemsPerLine becomes available/120 and
                        the grid fills edge to edge, gaining columns as the window widens.
                        2:3 keeps the wallpaper thumbnails portrait. Nothing drives these at
                        runtime: this page declares no FluidGridView.Triggers, so FluidGridView
                        never subscribes to SizeChanged and never writes either axis - the seed IS
                        the final value. Windows is untouched: its ItemsWrapGrid is the win: branch
                        below and keeps measuring the way it always has.
                    -->
                    <not_win:VariableSizedWrapGrid Orientation="Horizontal"
                                                   ItemWidth="120"
                                                   ItemHeight="180"
                                                   MaxWidth="1008" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.Header>
                <controls:HeaderedControl Margin="-20,64,-20,8">
                    <controls:SettingsButton x:Name="SelectFromGallery"
                                             Content="{CustomResource SelectFromGallery}"
                                             Click="{x:Bind ViewModel.ChangeToLocal}"
                                             Glyph="&#xEB9F;" />

                    <controls:SettingsButton Content="{CustomResource SetColor}"
                                             Click="{x:Bind ViewModel.ChangeToColor}"
                                             Glyph="&#xE2B1;" />
                </controls:HeaderedControl>
            </GridView.Header>
            <GridView.Footer>
                <controls:HeaderedControl Footer="{CustomResource ResetChatBackgroundsInfo}"
                                          Margin="-24,0,-24,32">
                    <controls:SettingsButton Content="{CustomResource ResetChatBackgrounds}"
                                             Click="{x:Bind ViewModel.Reset}"
                                             Foreground="{ThemeResource DangerButtonBackground}" />
                </controls:HeaderedControl>
            </GridView.Footer>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem"
                       BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin"
                            Value="4" />
                    <Setter Property="Padding"
                            Value="0" />
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch" />
                    <Setter Property="VerticalContentAlignment"
                            Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <controls:AspectView Loaded="Tile_Loaded"
                                         DataContextChanged="Tile_DataContextChanged">
                        <chats:ChatBackgroundPresenter />

                        <Grid VerticalAlignment="Center">
                            <Rectangle x:Name="NormalRectangle"
                                       Fill="{ThemeResource MessageServiceBackgroundBrush}"
                                       RadiusX="18"
                                       RadiusY="18"
                                       UseLayoutRounding="False"
                                       Height="36"
                                       Width="36" />
                            <FontIcon x:Name="CheckGlyph"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      Glyph="&#xE001;"
                                      FontSize="20"
                                      Foreground="#FFFFFF" />
                        </Grid>
                    </controls:AspectView>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <Border x:Name="FooterHost"
                Grid.Row="2" />
    </Grid>
</local:HostedPage>
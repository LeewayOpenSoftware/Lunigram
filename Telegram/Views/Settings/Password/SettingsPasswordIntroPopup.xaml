<controls:ContentPopup x:Class="Telegram.Views.Settings.SettingsPasswordIntroPopup"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:common="using:Telegram.Common"
                       xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:not_win="http://uno.ui/not_win"
                       xmlns:controls="using:Telegram.Controls"
                       mc:Ignorable="d not_win"
                       Padding="24,12,24,24">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <controls:AnimatedImage Source="ms-appx:///Assets/Animations/TwoFactorSetupIntro.tgs"
                                IsCachingEnabled="False"
                                AutoPlay="True"
                                FrameSize="140,140"
                                DecodeFrameType="Logical"
                                LoopCount="1"
                                Width="140"
                                Height="140"
                                Margin="0,0,0,12" />

        <TextBlock Text="{CustomResource SetAdditionalPassword}"
                   Style="{StaticResource PopupTextBlockStyle}"
                   TextAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,0,0,8"
                   Grid.Row="1" />

        <!--
            The same TextBlock twice, because Uno's XAML generator mis-compiles a {CustomResource}
            applied to an ATTACHED property: for
            common:TextBlockHelper.Markdown="{CustomResource X}" it emits a plain
            "__p1.Markdown = RetrieveCustomResource(...)" against the TARGET type, i.e. TextBlock,
            which has no such property - CS1061, at build time. (An x:Bind to the same attached
            property compiles correctly, which is why AuthorizationCodePage has never hit this.)

            Windows keeps the original line untouched; Skia gets a named TextBlock that the
            code-behind fills through TextBlockHelper.SetMarkdown, so the markdown is still parsed
            and the language-pack string is still the one TDLib returns.
        -->
        <win:TextBlock common:TextBlockHelper.Markdown="{CustomResource SetAdditionalPasswordInfo}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       TextAlignment="Center"
                       Grid.Row="2" />
        <not_win:TextBlock x:Name="Info"
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextAlignment="Center"
                           Grid.Row="2" />
    </Grid>
</controls:ContentPopup>

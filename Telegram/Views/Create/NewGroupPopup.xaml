<controls:ContentPopup x:Class="Telegram.Views.Create.NewGroupPopup"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:controls="using:Telegram.Controls"
                       xmlns:drawers="using:Telegram.Controls.Drawers"
                       xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       mc:Ignorable="d"
                       PrimaryButtonClick="OnPrimaryButtonClick"
                       IsPrimaryButtonEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
                       Padding="24,16,24,24">

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <HyperlinkButton x:Name="PhotoButton"
                             Click="{x:Bind ViewModel.ChoosePhoto}"
                             Style="{StaticResource EmptyHyperlinkButtonStyle}"
                             Height="64"
                             Width="64"
                             CornerRadius="32">
                <controls:ProfilePicture Source="{x:Bind ConvertPhoto(ViewModel.Title, ViewModel.Preview), Mode=OneWay}"
                                         Size="64" />
            </HyperlinkButton>

            <TextBlock Text="{CustomResource NewGroup}"
                       Style="{StaticResource PopupTextBlockStyle}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Grid.Column="1" />
        </Grid>

        <Grid Margin="0,16">
            <TextBox x:Name="TitleLabel"
                     Loaded="Title_Loaded"
                     Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{ThemeResource EmojiThemeFontFamily}"
                     MaxLength="{StaticResource ChatTitleMaxLength}"
                     Header="{CustomResource EnterGroupNamePlaceholder}">
                <!-- u012: STALE as of u-003 - EmojiDrawer is IN the subset now (Controls/Drawers/
                     EmojiDrawer.xaml.cs works around both ChoosingItemContainer never firing and
                     ItemsWrapGrid.FirstVisibleIndex throwing on Uno; see PORTING.md §6). The win:
                     exclusion below is still correct today, but for a different, non-technical
                     reason: the only way into this flyout is the GlyphButton right after it, and
                     that button ships Visibility="Collapsed" on BOTH platforms - an upstream
                     decision, not a port gap, so nothing is reachable here on Windows either.
                     Restoration candidate: if that GlyphButton is ever un-collapsed, this flyout
                     could be un-wrapped from win: too, since the thing it used to lack is here now. -->
                <win:FlyoutBase.AttachedFlyout>
                    <Flyout x:Name="EmojiFlyout"
                            Placement="Top"
                            ShowMode="Transient">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter"
                                   BasedOn="{StaticResource CommandFlyoutPresenterStyle}">
                                <Setter Property="Padding"
                                        Value="0" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <drawers:EmojiDrawer x:Name="EmojiPanel"
                                             ItemClick="Emoji_ItemClick"
                                             Width="300"
                                             Height="360" />
                    </Flyout>
                </win:FlyoutBase.AttachedFlyout>
            </TextBox>
            <controls:GlyphButton x:Name="EmojiButton"
                                  Visibility="Collapsed"
                                  Click="Emoji_Click"
                                  Glyph="&#xE76E;"
                                  AllowFocusOnInteraction="False"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Width="36"
                                  Height="32" />
        </Grid>

        <ComboBox ItemsSource="{x:Bind ViewModel.TtlOptions}"
                  SelectedIndex="{x:Bind ViewModel.Ttl, Mode=TwoWay}"
                  Header="{CustomResource AutoDeleteMessages}"
                  HorizontalAlignment="Stretch" />
    </StackPanel>
</controls:ContentPopup>

<local:ProfileTabPage x:Class="Telegram.Views.Profile.ProfileVoiceTabPage"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:common="using:Telegram.Common"
                      xmlns:controls="using:Telegram.Controls"
                      xmlns:cells="using:Telegram.Controls.Cells"
                      xmlns:messages="using:Telegram.Controls.Messages"
                      xmlns:local="using:Telegram.Views.Profile"
                      xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:not_win="http://uno.ui/not_win"
                      mc:Ignorable="d not_win"
                      ItemsSource="{x:Bind ViewModel.Voice.ItemsView, Mode=OneWay}">

    <Grid>
        <controls:TableListView x:Name="ScrollingHost"
                                SelectionMode="None"
                                ItemContainerStyle="{StaticResource ExtendedTableListViewItemStyle}"
                                ChoosingItemContainer="OnChoosingItemContainer"
                                ContainerContentChanging="OnContainerContentChanging">
            <common:SelectedItemsBinder.Attached>
                <common:SelectedItemsBinder SelectionMode="Auto"
                                            SelectedItems="{x:Bind ViewModel.SelectedItems}" />
            </common:SelectedItemsBinder.Attached>
            <ListView.Template>
                <ControlTemplate TargetType="ListView">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ItemsPresenter Header="{TemplateBinding Header}"
                                        HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                        HeaderTransitions="{TemplateBinding HeaderTransitions}"
                                        Footer="{TemplateBinding Footer}"
                                        FooterTemplate="{TemplateBinding FooterTemplate}"
                                        FooterTransitions="{TemplateBinding FooterTransitions}"
                                        Padding="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </ListView.Template>
            <ListView.Header>
                <StackPanel>
                    <Border x:Name="Header" />

                    <win:Grid x:Name="SearchRoot"
                              x:Load="False"
                              MaxWidth="1000"
                              Margin="24,0">
                        <TextBox x:Name="Search"
                                 Text="{x:Bind ViewModel.Voice.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{CustomResource Search}"
                                 BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                 Margin="0,4,0,2"
                                 Padding="34,5,6,6"
                                 InputScope="Search" />

                        <controls:GlyphButton Glyph="&#xE721;"
                                              FontSize="16"
                                              Width="36"
                                              Height="32"
                                              IsTabStop="False"
                                              AutomationProperties.AccessibilityView="Raw"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                    </win:Grid>
                    <!--
                        Same subtree, without x:Load, for the same reason as the Files / Links /
                        Music tabs: an x:Load="False" element is an ElementStub in Uno until
                        something materializes it, and the one case this port measured never
                        materialized at all - not from the constructor, not from Loaded, not from
                        LayoutUpdated (PORTING.md 6). The failure would be silent: no search box in
                        this tab and nothing in the log. Declaring it loaded and collapsed costs one
                        Grid; the code-behind shows it instead of calling FindName.
                    -->
                    <not_win:Grid x:Name="SearchRoot"
                                  Visibility="Collapsed"
                                  MaxWidth="1000"
                                  Margin="24,0">
                        <TextBox x:Name="Search"
                                 Text="{x:Bind ViewModel.Voice.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{CustomResource Search}"
                                 BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                 Margin="0,4,0,2"
                                 Padding="34,5,6,6"
                                 InputScope="Search" />

                        <controls:GlyphButton Glyph="&#xE721;"
                                              FontSize="16"
                                              Width="36"
                                              Height="32"
                                              IsTabStop="False"
                                              AutomationProperties.AccessibilityView="Raw"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                    </not_win:Grid>
                </StackPanel>
            </ListView.Header>
            <ListView.Footer>
                <Border Height="60" />
            </ListView.Footer>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <cells:SharedVoiceCell />
                </DataTemplate>
            </ListView.ItemTemplate>
        </controls:TableListView>
    </Grid>
</local:ProfileTabPage>

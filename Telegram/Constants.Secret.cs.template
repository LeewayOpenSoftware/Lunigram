// TEMPLATE. Copy this file to Telegram/Constants.Secret.cs and fill in your own values:
//
//     cp Telegram/Constants.Secret.cs.template Telegram/Constants.Secret.cs
//
// Constants.Secret.cs is gitignored (.gitignore: /Telegram/Constants.Secret.cs) and MUST stay
// that way. Telegram's terms require every client build to use its own API credentials, so the
// file is per-developer and is never committed. This template is committed; your filled-in copy
// is not.
//
// Get api_id and api_hash from https://my.telegram.org/apps (log in with the phone number of
// the account you want to own the application, then "API development tools").
//
// The fields are declared `public static readonly` in Telegram/Constants.cs and assigned here in
// a static constructor, which is why this file is a REQUIRED input rather than an optional one:
// leaving it out does not degrade gracefully, it fails to compile.

namespace Telegram
{
    public static partial class Constants
    {
        static Constants()
        {
            // Required. Your own credentials from https://my.telegram.org/apps.
            ApiId = 0;
            ApiHash = string.Empty;

            // Free-form build identity. Anything is fine for a local build.
            AppChannel = "dev";
            BuildNumber = 0;

            // Optional, all safe to leave empty for a local build. They wire up crash reporting
            // and on-device text recognition, neither of which is needed to run the client.
            //   AppReportsId = string.Empty;
            //   AppCenterId = string.Empty;
            //   TextRecognizerModelKey = string.Empty;
        }
    }
}

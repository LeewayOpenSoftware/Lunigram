<controls:UserControlEx x:Class="Telegram.Controls.Drawers.StickerDrawer"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:not_win="http://uno.ui/not_win"
                        xmlns:common="using:Telegram.Common"
                        xmlns:controls="using:Telegram.Controls"
                        xmlns:selectors="using:Telegram.Selectors"
                        xmlns:viewModels="using:Telegram.ViewModels.Drawers"
                        mc:Ignorable="d not_win"
                        d:DesignHeight="300"
                        d:DesignWidth="400">

    <controls:UserControlEx.Resources>
        <CollectionViewSource x:Name="StickersSource"
                              Source="{x:Bind ViewModel.Stickers, Mode=OneWay}"
                              ItemsPath="Stickers"
                              IsSourceGrouped="True" />

        <!--
            Linux only. One sticker cell. Fixed at 68 square, which is the template's 64x64
            FrameSize plus 2px of breathing room either side, so the layout below never has to
            ask a not-yet-decoded AnimatedImage how big it wants to be.
        -->
        <DataTemplate x:Key="LinuxStickerTemplate">
            <!--
                The cell stretches, the sticker does not. Height stays 68 because that is what the
                row arithmetic below counts in; the width is left to the layout so the columns
                share the whole box instead of leaving a strip of dead space down the right.
                Background must be Transparent and not unset, or the cell is not hit-testable and
                the tap that sends the sticker never reaches it.
            -->
            <Grid Width="68"
                  Height="68"
                  Background="Transparent"
                  Loaded="OnStickerCellLoaded"
                  Unloaded="OnStickerCellUnloaded"
                  Tapped="OnStickerTapped">
                <controls:AnimatedImage AutoPlay="False"
                                        LimitFps="True"
                                        FrameSize="64,64"
                                        DecodeFrameType="Logical"
                                        Width="64"
                                        Height="64"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Ready="Player_Ready" />
            </Grid>
        </DataTemplate>

        <!--
            Linux only. One sticker SET: its title, then its own stickers in a wrap layout. The
            title here is what GroupStyle.HeaderTemplate used to draw; it has to move into the
            item template because Uno only renders group headers from the virtualizing panel
            path, and no virtualizing panel that wraps exists on this head.
        -->
        <!--
            Linux only. ONE ROW: either a set's title, or a single line of up to `columns`
            stickers. Height comes from the item and is known before anything is measured, and a
            row's cells are a bounded ItemsControl rather than a repeater, so nothing in this tree
            has a size that depends on realising its children. Telegram.Linux/Xaml/DrawerRows.cs
            has the three measured failures that led here.
        -->
        <DataTemplate x:Key="LinuxStickerRowTemplate">
            <Grid Height="{Binding Height}">
                <TextBlock x:Name="RowTitle"
                           Text="{Binding Title}"
                           Style="{StaticResource InfoCaptionTextBlockStyle}"
                           VerticalAlignment="Bottom"
                           Margin="10,0,10,4" />
                <ItemsControl x:Name="RowCells"
                              ItemsSource="{Binding Cells}"
                              ItemTemplate="{StaticResource LinuxStickerTemplate}"
                              HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </DataTemplate>
    </controls:UserControlEx.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--
                The row the drawer's search box moves into on Linux. Empty and therefore zero-high
                on Windows, where the box stays the list's Header and nothing changes.
                Telegram.Linux/Xaml/DrawerHeaderHost.cs says why it cannot stay there on Uno.
            -->
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border x:Name="SearchHost"
                Grid.Row="1" />
        <GridView x:Name="List"
                  ItemsSource="{x:Bind StickersSource.View, Mode=OneWay}"
                  common:FluidGridView.OrientationOnly="False"
                  ChoosingGroupHeaderContainer="OnChoosingGroupHeaderContainer"
                  ChoosingItemContainer="OnChoosingItemContainer"
                  ContainerContentChanging="OnContainerContentChanging"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  ItemClick="Stickers_ItemClick"
                  Loaded="Stickers_Loaded"
                  Padding="2,0"
                  Grid.Row="2">
            <GridView.Header>
                <controls:EmojiSearchBox x:Name="SearchField"
                                         AllowFocusOnInteraction="True"
                                         PlaceholderText="{CustomResource Search}"
                                         TextChanged="SearchField_TextChanged"
                                         CategorySelected="SearchField_CategorySelected"
                                         Margin="10,8,10,0" />
            </GridView.Header>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <controls:AnimatedImage x:Name="Player"
                                                AutoPlay="False"
                                                LimitFps="True"
                                                FrameSize="64,64"
                                                DecodeFrameType="Logical"
                                                Ready="Player_Ready" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="viewModels:StickerSetViewModel">
                            <TextBlock Text="{x:Bind Title}"
                                       Style="{StaticResource InfoCaptionTextBlockStyle}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="GridViewHeaderItem">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Setter Property="FontFamily"
                                    Value="{ThemeResource ContentControlThemeFontFamily}" />
                            <Setter Property="FontSize"
                                    Value="{ThemeResource ListViewHeaderItemThemeFontSize}" />
                            <Setter Property="Margin"
                                    Value="0,0,0,0" />
                            <Setter Property="Padding"
                                    Value="10,8,10,8" />
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch" />
                            <Setter Property="VerticalContentAlignment"
                                    Value="Top" />
                            <Setter Property="MinHeight"
                                    Value="32" />
                            <Setter Property="Height"
                                    Value="32" />
                            <Setter Property="UseSystemFocusVisuals"
                                    Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewHeaderItem">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter x:Name="ContentPresenter"
                                                              Margin="{TemplateBinding Padding}"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                </GroupStyle>
            </GridView.GroupStyle>
            <GridView.Footer>
                <Border Height="12" />
            </GridView.Footer>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem"
                       BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin"
                            Value="0" />
                    <Setter Property="Padding"
                            Value="2" />
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch" />
                    <Setter Property="VerticalContentAlignment"
                            Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemContainerTransitions>
                <TransitionCollection />
            </GridView.ItemContainerTransitions>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--
                        Uno's ItemsWrapGrid is a shell: [NotImplemented] for __SKIA__, derived
                        straight from Panel, no MeasureOverride and no ArrangeOverride, so it
                        measures no width and materialises no container. Measured on a live capture
                        of this very drawer: `ItemsWrapGrid [314,84 0x248]`, zero wide and empty,
                        next to an ItemsStackPanel toolbar at `[55,49 3636x40]` with 32x32 items in
                        it. Same substitution as CommonStyles' default GridView panel and the three
                        profile grid tabs. VariableSizedWrapGrid does not virtualize.
                        The header had to leave the list for this to help at all: see
                        Telegram.Linux/Xaml/DrawerHeaderHost.cs.
                    -->
                    <win:ItemsWrapGrid Orientation="Horizontal"
                                       AreStickyGroupHeadersEnabled="False"
                                       CacheLength="2" />
                    <!--
                        ItemWidth/ItemHeight are NOT decoration, they are what stops Uno throwing.
                        Measured on the running app: with them unset (NaN) VariableSizedWrapGrid
                        asks child 0 for its DesiredSize and uses that as the cell size
                        (ComputeBounds). Child 0 here is an AnimatedImage with AutoPlay="False", so
                        until its first frame is ready it desires 0x0, and a cell size of 0 makes
                        CalculateOccupancyMap divide by it, so the map comes out 1x1 while the list
                        holds 2498 items, and FindAndFillNextAvailableRect walks straight off the
                        end of the block:

                          System.IndexOutOfRangeException
                            at VariableSizedWrapGrid.OccupancyBlock.GetItem
                            at VariableSizedWrapGrid.OccupancyMap.GetCurrentItemRect
                            at VariableSizedWrapGrid.ArrangeOverride

                        unhandled, on the dispatcher tick, every tick - which is both the empty
                        grid and the hard freeze. 68 = the 64x64 FrameSize of the item template
                        plus the container's 2px padding either side.
                    -->
                    <!--
                        A plain StackPanel, and it is never asked to lay anything out. This GridView
                        stays in the tree only because IDrawer.ScrollingHost is typed ListViewBase
                        and StickerPanel reads it; on this head it is emptied and collapsed, and the
                        rows above are what actually draws. It used to hold a VariableSizedWrapGrid.
                        That has to go even from a dormant panel: VSWG THROWS IndexOutOfRangeException
                        out of its own occupancy map during MEASURE on this head, with BOTH axes
                        fixed - fixing the axes only avoided the divide-by-zero, not the walk off
                        the end of the block. Measured by Oscar, ten times on one first open:
                          OccupancyBlock.GetItem <- IsOccupied <- FindNextAvailableRectInternal
                          <- FindAndFillNextAvailableRect <- CalculateOccupancyMap <- MeasureOverride
                        So it is not used anywhere in this file any more, dormant or not.
                    -->
                    <not_win:StackPanel />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>

        <!--
            Linux only, and it replaces the GridView above rather than decorating it.

            Measured on the running app, this build, panel open, 2498 stickers loaded:

              panel=VariableSizedWrapGrid children=0     size=318x601   (before the fill)
              panel=VariableSizedWrapGrid children=2498  size=0x0       (after it)

            So the items DO reach the panel and grouping is not what stops them: Uno flattens the
            grouped CollectionView and the ItemsControl-managed path builds a container for every
            one of the 2498. That is the whole problem. VariableSizedWrapGrid is a plain Panel, so
            it does not virtualize, and building 2498 AnimatedImage containers took NINETEEN
            SECONDS on the UI thread - the log gap between the collection change and the view
            model's own "filled" line. The panel reads 0x0 because it is still mid-storm.

            Of the panels Uno ships, none both wraps and virtualizes: ItemsWrapGrid and WrapGrid
            are [NotImplemented] stubs on __SKIA__, ItemsStackPanel virtualizes but stacks, and
            VariableSizedWrapGrid wraps but does not virtualize. ItemsRepeater does, with
            UniformGridLayout, and both are fully implemented here (UniformGridLayout carries no
            NotImplemented attribute at all).

            So: an outer repeater over the 36 SETS, which virtualizes, and one inner wrap repeater
            per set over its own 20-70 stickers. Only visible sets are ever built, and each set
            keeps a real title - the group header the GroupStyle could not draw.
        -->
        <not_win:ScrollViewer x:Name="RepeaterHost"
                              Grid.Row="2"
                              Visibility="Collapsed"
                              Padding="2,0"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Visible">
            <ItemsRepeater x:Name="Repeater"
                           ItemTemplate="{StaticResource LinuxStickerRowTemplate}">
                <ItemsRepeater.Layout>
                    <StackLayout />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </not_win:ScrollViewer>

        <Grid x:Name="ToolbarContainer">
            <Border x:Name="Separator" />

            <GridView x:Name="Toolbar"
                      ItemsSource="{x:Bind ViewModel.SavedStickers}"
                      Height="40"
                      IsItemClickEnabled="True"
                      ItemClick="Toolbar_ItemClick"
                      SelectionChanged="Toolbar_SelectionChanged"
                      ContainerContentChanging="Toolbar_ContainerContentChanging"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      ScrollViewer.HorizontalScrollMode="Auto"
                      ScrollViewer.IsHorizontalScrollChainingEnabled="False"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      Padding="4,0,0,0"
                      Grid.Row="0">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem"
                           BasedOn="{StaticResource DefaultGridViewItemStyle}">
                        <Setter Property="Margin"
                                Value="0,4,2,4" />
                        <Setter Property="MinHeight"
                                Value="0" />
                        <Setter Property="MinWidth"
                                Value="0" />
                        <Setter Property="Height"
                                Value="32" />
                        <Setter Property="Width"
                                Value="32" />
                        <Setter Property="Padding"
                                Value="4" />
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        <Setter Property="VerticalContentAlignment"
                                Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplateSelector>
                    <selectors:StickerSetTemplateSelector>
                        <selectors:StickerSetTemplateSelector.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <controls:AnimatedImage x:Name="Player"
                                                            AutoPlay="False"
                                                            LimitFps="True"
                                                            FrameSize="24,24"
                                                            DecodeFrameType="Logical"
                                                            Ready="Toolbar_Ready"
                                                            Width="24"
                                                            Height="24" />
                                </Grid>
                            </DataTemplate>

                        </selectors:StickerSetTemplateSelector.ItemTemplate>
                        <selectors:StickerSetTemplateSelector.GroupTemplate>
                            <DataTemplate>
                                <Grid>
                                    <controls:ProfilePicture Size="24" />
                                </Grid>
                            </DataTemplate>
                        </selectors:StickerSetTemplateSelector.GroupTemplate>
                        <selectors:StickerSetTemplateSelector.IconTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent">
                                    <FontIcon FontFamily="{StaticResource TelegramThemeFontFamily}" />
                                </Grid>
                            </DataTemplate>
                        </selectors:StickerSetTemplateSelector.IconTemplate>
                    </selectors:StickerSetTemplateSelector>
                </GridView.ItemTemplateSelector>
                <GridView.ItemContainerTransitions>
                    <TransitionCollection />
                </GridView.ItemContainerTransitions>
            </GridView>
        </Grid>
    </Grid>

</controls:UserControlEx>

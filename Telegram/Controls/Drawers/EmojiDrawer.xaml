<controls:UserControlEx x:Class="Telegram.Controls.Drawers.EmojiDrawer"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:not_win="http://uno.ui/not_win"
                        xmlns:common="using:Telegram.Common"
                        xmlns:controls="using:Telegram.Controls"
                        xmlns:selectors="using:Telegram.Selectors"
                        xmlns:viewModels="using:Telegram.ViewModels.Drawers"
                        mc:Ignorable="d not_win"
                        d:DesignHeight="300"
                        d:DesignWidth="400">

    <controls:UserControlEx.Resources>
        <CollectionViewSource x:Name="EmojiCollection"
                              Source="{x:Bind ViewModel.Items}"
                              IsSourceGrouped="True"
                              ItemsPath="Stickers" />

        <DataTemplate x:Key="EmojiTemplate"
                      x:DataType="common:EmojiData">
            <TextBlock x:Phase="0"
                       Text="{x:Bind Value, Mode=OneTime}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="22"
                       FontFamily="{ThemeResource EmojiThemeFontFamily}" />
        </DataTemplate>

        <DataTemplate x:Key="EmojiSkinTemplate"
                      x:DataType="common:EmojiSkinData">
            <TextBlock x:Phase="0"
                       Text="{x:Bind Value, Mode=OneWay}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="22"
                       FontFamily="{ThemeResource EmojiThemeFontFamily}" />
        </DataTemplate>

        <DataTemplate x:Key="ItemTemplate">
            <Grid Background="Transparent">
                <controls:AnimatedImage x:Name="Player"
                                        AutoPlay="False"
                                        LimitFps="True"
                                        FrameSize="32,32"
                                        DecodeFrameType="Logical"
                                        Width="32"
                                        Height="32"
                                        Ready="Player_Ready"
                                        ReplacementColor="{ThemeResource TelegramForegroundAccentBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MoreTemplate">
            <Grid Background="{ThemeResource MessageOverlayBackgroundBrush}"
                  CornerRadius="{ThemeResource MessageOverlayCornerRadius}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Padding="6,1,6,3">
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="White"
                           TextAlignment="Right"
                           TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>

        <!--
            Linux only. ONE cell for all four kinds of emoji item, because an ItemsRepeater cannot
            take a DataTemplateSelector on this head: Uno wraps the selector in ItemTemplateWrapper,
            whose GetElement reads args.Data, and ElementFactoryGetArgs.Data is [NotImplemented] for
            __SKIA__ with no backing field - its setter only logs and its getter THROWS. A plain
            DataTemplate short-circuits before that read and works, so the four templates above
            collapse into one cell with three faces, picked in OnEmojiElementPrepared:
            a glyph (EmojiData and EmojiSkinData), an animated custom emoji (StickerViewModel), and
            the "+N" tile (MoreStickerViewModel). Background must be Transparent rather than unset
            or the cell is not hit-testable and the tap never arrives.
        -->
        <DataTemplate x:Key="LinuxEmojiCellTemplate">
            <Grid HorizontalAlignment="Stretch"
                  Background="Transparent"
                  Loaded="OnEmojiCellLoaded"
                  Unloaded="OnEmojiCellUnloaded"
                  Tapped="OnEmojiTapped">
                <TextBlock x:Name="Glyph"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontFamily="{ThemeResource EmojiThemeFontFamily}" />
                <controls:AnimatedImage x:Name="Player"
                                        AutoPlay="False"
                                        LimitFps="True"
                                        DecodeFrameType="Logical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Ready="Player_Ready"
                                        ReplacementColor="{ThemeResource TelegramForegroundAccentBrush}" />
                <Grid x:Name="More"
                      Background="{ThemeResource MessageOverlayBackgroundBrush}"
                      CornerRadius="{ThemeResource MessageOverlayCornerRadius}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="Collapsed"
                      Padding="6,1,6,3">
                    <TextBlock x:Name="MoreText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="White"
                               TextAlignment="Right"
                               TextWrapping="NoWrap" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!--
            Linux only. One GROUP: its title, then its own items in a wrap layout. The title is what
            GroupStyle.HeaderTemplate used to draw; it has to move into the item template because
            Uno only renders group headers from the virtualizing panel path, and no panel that both
            wraps and virtualizes exists on this head.
        -->
        <!--
            Linux only. ONE ROW: either a group's title, or a single line of up to `columns` cells.
            There are two of these because the cell size differs by mode and markup takes no
            variable - 40 in the composer, 36 in the picker modes - and the constructor picks one.
            Height comes from the item, known before anything is measured, and a row's cells are a
            bounded ItemsControl rather than a repeater, so nothing here has a size that depends on
            realising its children. Telegram.Linux/Xaml/DrawerRows.cs has the failures that led here.
        -->
        <DataTemplate x:Key="LinuxEmojiRowTemplate40">
            <Grid Height="{Binding Height}">
                <TextBlock x:Name="RowTitle"
                           Text="{Binding Title}"
                           Style="{StaticResource InfoCaptionTextBlockStyle}"
                           VerticalAlignment="Bottom"
                           Margin="8,0,8,4" />
                <ItemsControl x:Name="RowCells"
                              ItemsSource="{Binding Cells}"
                              ItemTemplate="{StaticResource LinuxEmojiCellTemplate}"
                              HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LinuxEmojiRowTemplate36">
            <Grid Height="{Binding Height}">
                <TextBlock x:Name="RowTitle"
                           Text="{Binding Title}"
                           Style="{StaticResource InfoCaptionTextBlockStyle}"
                           VerticalAlignment="Bottom"
                           Margin="8,0,8,4" />
                <ItemsControl x:Name="RowCells"
                              ItemsSource="{Binding Cells}"
                              ItemTemplate="{StaticResource LinuxEmojiCellTemplate}"
                              HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </DataTemplate>
    </controls:UserControlEx.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--
                The row the drawer's search box moves into on Linux. Empty and therefore zero-high
                on Windows, where the box stays the list's Header and nothing changes.
                Telegram.Linux/Xaml/DrawerHeaderHost.cs says why it cannot stay there on Uno.
            -->
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border x:Name="SearchHost"
                Grid.Row="1" />
        <GridView x:Name="List"
                  ItemsSource="{x:Bind EmojiCollection.View, Mode=OneWay}"
                  common:FluidGridView.OrientationOnly="False"
                  ChoosingItemContainer="OnChoosingItemContainer"
                  ChoosingGroupHeaderContainer="OnChoosingGroupHeaderContainer"
                  ContainerContentChanging="OnContainerContentChanging"
                  ItemClick="ListView_ItemClick"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  Loaded="OnLoaded"
                  Grid.Row="2">
            <GridView.Header>
                <StackPanel>
                    <controls:EmojiSearchBox x:Name="SearchField"
                                             AllowFocusOnInteraction="True"
                                             PlaceholderText="{CustomResource Search}"
                                             CategorySelected="SearchField_CategorySelected"
                                             Margin="12,8,12,8" />

                    <Grid x:Name="DefaultIcon"
                          HorizontalAlignment="Left"
                          Padding="0,0,4,4">
                        <Grid x:Name="TopicIconRoot"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed">
                            <Path x:Name="TopicIconPath"
                                  Data="M2.00003 14C2.00003 7.37258 7.37261 2 14 2C20.6274 2 26 7.37258 26 14C26 20.6274 20.6274 26 14 26C11.964 26 10.0446 25.4924 8.36332 24.5963L3.59342 25.9527C2.65148 26.2206 1.78133 25.3504 2.04919 24.4085L3.40531 19.6396C2.50826 17.9577 2.00003 16.0372 2.00003 14Z" />
                            <TextBlock x:Name="TopicIconText"
                                       TextAlignment="Center"
                                       Foreground="#FFFFFF"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Left"
                                       Margin="0,2,0,0"
                                       Width="28" />
                        </Grid>
                        <TextBlock x:Name="EmojiStatusIconRoot"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="&#xEA87;"
                                   Foreground="{ThemeResource TelegramForegroundAccentBrush}"
                                   FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                   FontSize="24"
                                   Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </GridView.Header>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="MinWidth"
                            Value="0" />
                    <Setter Property="MinHeight"
                            Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewItem">
                                <ContentPresenter HorizontalContentAlignment="Stretch"
                                                  VerticalContentAlignment="Stretch"
                                                  Padding="0" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <!-- Groups are EmojiGroup, RecentEmoji or StickerSetViewModel, so the
                             template is typed on the interface the three share. -->
                        <DataTemplate x:DataType="viewModels:IDrawerGroup">
                            <Grid Visibility="{x:Bind Title, Converter={StaticResource NullToVisibilityConverter}}"
                                  Padding="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Title}"
                                           TextWrapping="NoWrap"
                                           Style="{StaticResource InfoBodyTextBlockStyle}" />

                                <controls:SettingsButton Content="{CustomResource Add}"
                                                         Visibility="{x:Bind IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}"
                                                         Style="{StaticResource PillButtonStyle}"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Center"
                                                         Padding="12,1,12,2"
                                                         CornerRadius="12"
                                                         Margin="0,-6"
                                                         Grid.Column="1" />
                            </Grid>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="GridViewHeaderItem">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Setter Property="FontFamily"
                                    Value="{ThemeResource ContentControlThemeFontFamily}" />
                            <Setter Property="FontSize"
                                    Value="{ThemeResource ListViewHeaderItemThemeFontSize}" />
                            <Setter Property="Margin"
                                    Value="0,0,0,0" />
                            <Setter Property="Padding"
                                    Value="10,0,10,0" />
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch" />
                            <Setter Property="VerticalContentAlignment"
                                    Value="Top" />
                            <Setter Property="MinHeight"
                                    Value="0" />
                            <Setter Property="UseSystemFocusVisuals"
                                    Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewHeaderItem">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter x:Name="ContentPresenter"
                                                              Margin="{TemplateBinding Padding}"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                </GroupStyle>
            </GridView.GroupStyle>
            <GridView.ItemContainerTransitions>
                <TransitionCollection />
            </GridView.ItemContainerTransitions>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--
                        Uno's ItemsWrapGrid is a shell: [NotImplemented] for __SKIA__, derived
                        straight from Panel, no MeasureOverride and no ArrangeOverride, so it
                        measures no width and materialises no container. Measured on a live capture
                        of this very drawer: `ItemsWrapGrid [314,84 0x248]`, zero wide and empty,
                        next to an ItemsStackPanel toolbar at `[55,49 3636x40]` with 32x32 items in
                        it. Same substitution as CommonStyles' default GridView panel and the three
                        profile grid tabs. VariableSizedWrapGrid does not virtualize.
                        The header had to leave the list for this to help at all: see
                        Telegram.Linux/Xaml/DrawerHeaderHost.cs.
                    -->
                    <win:ItemsWrapGrid Orientation="Horizontal"
                                       AreStickyGroupHeadersEnabled="False" />
                    <!--
                        A plain StackPanel, and it is never asked to lay anything out. This GridView
                        stays in the tree only because IDrawer.ScrollingHost is typed ListViewBase
                        and StickerPanel reads it; on this head it is emptied and collapsed, and the
                        rows above are what actually draws. It used to hold a VariableSizedWrapGrid.
                        That has to go even from a dormant panel: VSWG THROWS IndexOutOfRangeException
                        out of its own occupancy map during MEASURE on this head, with BOTH axes
                        fixed - fixing the axes only avoided the divide-by-zero, not the walk off
                        the end of the block. Measured by Oscar, ten times on one first open:
                          OccupancyBlock.GetItem <- IsOccupied <- FindNextAvailableRectInternal
                          <- FindAndFillNextAvailableRect <- CalculateOccupancyMap <- MeasureOverride
                        So it is not used anywhere in this file any more, dormant or not.
                    -->
                    <not_win:StackPanel />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>

        <!--
            Linux only, and it REPLACES the GridView above rather than decorating it. Same three
            faults the sticker drawer had and the same cure (Oscar, ddb6d40): the CollectionViewSource
            binding never delivers, the grouped view does not rebuild when the collection fills, and
            no panel Uno ships both wraps and virtualizes. An outer repeater over the GROUPS, which
            virtualizes, and one inner wrap repeater per group over its own emoji.
        -->
        <not_win:ScrollViewer x:Name="RepeaterHost"
                              Grid.Row="2"
                              Visibility="Collapsed"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Visible">
            <ItemsRepeater x:Name="Repeater"
                           ItemTemplate="{StaticResource LinuxEmojiRowTemplate40}">
                <ItemsRepeater.Layout>
                    <StackLayout />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </not_win:ScrollViewer>

        <Grid x:Name="ToolbarContainer">
            <Border x:Name="Separator" />

            <GridView x:Name="Toolbar2"
                      ItemsSource="{x:Bind ViewModel.InstalledSets}"
                      Height="40"
                      IsItemClickEnabled="True"
                      ItemClick="Toolbar_ItemClick"
                      SelectionChanged="Toolbar_SelectionChanged"
                      ContainerContentChanging="Toolbar_ContainerContentChanging"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      ScrollViewer.HorizontalScrollMode="Auto"
                      ScrollViewer.IsHorizontalScrollChainingEnabled="False"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      Padding="4,0,0,0"
                      Grid.Row="0">
                <GridView.Header>
                    <Grid x:Name="Toolbar3"
                          Margin="0,0,4,0">
                        <Border x:Name="ToolbarPill"
                                Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                CornerRadius="4"
                                Height="32" />
                        <GridView x:Name="Toolbar"
                                  ItemsSource="{x:Bind ViewModel.StandardSets}"
                                  Height="32"
                                  Width="144"
                                  IsItemClickEnabled="True"
                                  ItemClick="Toolbar_ItemClick"
                                  SelectionChanged="Toolbar_SelectionChanged"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                  ScrollViewer.HorizontalScrollMode="Auto"
                                  ScrollViewer.IsHorizontalScrollChainingEnabled="False"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  Padding="0">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal"
                                                     HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem"
                                       BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                    <Setter Property="Margin"
                                            Value="0,0,0,0" />
                                    <Setter Property="MinHeight"
                                            Value="0" />
                                    <Setter Property="MinWidth"
                                            Value="0" />
                                    <Setter Property="Height"
                                            Value="32" />
                                    <Setter Property="Width"
                                            Value="32" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="common:EmojiGroup">
                                    <Border AutomationProperties.Name="{x:Bind Title}"
                                            ToolTipService.ToolTip="{x:Bind Title}"
                                            Background="Transparent">
                                        <TextBlock Text="{x:Bind Glyph}"
                                                   FontFamily="{StaticResource TelegramThemeFontFamily}"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsColorFontEnabled="False"
                                                   Margin="0" />
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                            <GridView.ItemContainerTransitions>
                                <TransitionCollection />
                            </GridView.ItemContainerTransitions>
                        </GridView>
                    </Grid>
                </GridView.Header>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem"
                           BasedOn="{StaticResource DefaultGridViewItemStyle}">
                        <Setter Property="Margin"
                                Value="0,2,4,2" />
                        <Setter Property="MinHeight"
                                Value="0" />
                        <Setter Property="MinWidth"
                                Value="0" />
                        <Setter Property="Height"
                                Value="32" />
                        <Setter Property="Width"
                                Value="32" />
                        <Setter Property="Padding"
                                Value="0" />
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        <Setter Property="VerticalContentAlignment"
                                Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplateSelector>
                    <selectors:StickerSetTemplateSelector>
                        <selectors:StickerSetTemplateSelector.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <controls:AnimatedImage x:Name="Player"
                                                            AutoPlay="False"
                                                            LimitFps="True"
                                                            FrameSize="24,24"
                                                            DecodeFrameType="Logical"
                                                            Ready="Toolbar_Ready"
                                                            Width="24"
                                                            Height="24"
                                                            ReplacementColor="{ThemeResource TelegramForegroundAccentBrush}" />
                                </Grid>
                            </DataTemplate>
                        </selectors:StickerSetTemplateSelector.ItemTemplate>
                        <selectors:StickerSetTemplateSelector.GroupTemplate>
                            <DataTemplate>
                                <controls:ProfilePicture Margin="6" />
                            </DataTemplate>
                        </selectors:StickerSetTemplateSelector.GroupTemplate>
                        <selectors:StickerSetTemplateSelector.IconTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent">
                                    <FontIcon FontFamily="{StaticResource TelegramThemeFontFamily}" />
                                </Grid>
                            </DataTemplate>
                        </selectors:StickerSetTemplateSelector.IconTemplate>
                    </selectors:StickerSetTemplateSelector>
                </GridView.ItemTemplateSelector>
                <!--<GridView.Footer>
                    <StackPanel Orientation="Horizontal">
                        <controls:GlyphButton Click="Settings_Click"
                                              Width="{ThemeResource AppBarThemeCompactHeight}"
                                              Height="{ThemeResource AppBarThemeCompactHeight}"
                                              Glyph="&#xE713;" />
                    </StackPanel>
                </GridView.Footer>-->
                <GridView.ItemContainerTransitions>
                    <TransitionCollection />
                </GridView.ItemContainerTransitions>
            </GridView>
        </Grid>
    </Grid>
</controls:UserControlEx>

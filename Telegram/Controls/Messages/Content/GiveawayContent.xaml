<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Telegram.Controls.Messages.Content"
                    xmlns:controls="using:Telegram.Controls"
                    xmlns:common="using:Telegram.Common"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:not_win="http://uno.ui/not_win"
                    mc:Ignorable="d not_win">

    <Style TargetType="local:GiveawayContent">
        <Setter Property="IsTabStop"
                Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GiveawayContent">
                    <StackPanel MaxWidth="248">
                        <Grid>
                            <controls:AnimatedImage x:Name="Animation"
                                                    Width="120"
                                                    Height="120"
                                                    FrameSize="120,120"
                                                    DecodeFrameType="Logical"
                                                    Margin="0,-32,0,0" />
                            <controls:BadgeControl x:Name="Count"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom" />
                        </Grid>

                        <!--
                            u004 / PORTING.md §6: {CustomResource} on an ATTACHED property
                            mis-compiles under Uno - it writes the plain "Markdown" property
                            straight onto the target TextBlock, CS1061. Windows keeps the
                            original; Skia gets a named plain TextBlock filled from code-behind
                            via TextBlockHelper.SetMarkdown (GiveawayContent.xaml.cs, #if LINUX).
                        -->
                        <win:TextBlock common:TextBlockHelper.Markdown="{CustomResource BoostingGiveawayPrizes}"
                                   TextAlignment="Center"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Margin="0,8,0,0"
                                   FontSize="16" />
                        <not_win:TextBlock x:Name="PrizesHeader"
                                   TextAlignment="Center"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Margin="0,8,0,0"
                                   FontSize="16" />
                        <TextBlock x:Name="PrizesLabel"
                                   TextAlignment="Center"
                                   Style="{StaticResource BodyTextBlockStyle}" />

                        <win:TextBlock common:TextBlockHelper.Markdown="{CustomResource BoostingGiveawayMsgParticipants}"
                                   TextAlignment="Center"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Margin="0,8,0,0"
                                   FontSize="16" />
                        <not_win:TextBlock x:Name="ParticipantsHeader"
                                   TextAlignment="Center"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Margin="0,8,0,0"
                                   FontSize="16" />
                        <TextBlock x:Name="ParticipantsLabel"
                                   TextAlignment="Center"
                                   Style="{StaticResource BodyTextBlockStyle}" />

                        <StackPanel x:Name="ParticipantsPanel"
                                    Orientation="Vertical"
                                    Margin="0,0,0,8" />

                        <TextBlock x:Name="FromLabel"
                                   TextAlignment="Center"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   FontFamily="{ThemeResource EmojiThemeFontFamily}" />

                        <win:TextBlock common:TextBlockHelper.Markdown="{CustomResource BoostingWinnersDate}"
                                   TextAlignment="Center"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Margin="0,8,0,0"
                                   FontSize="16" />
                        <not_win:TextBlock x:Name="WinnersHeader"
                                   TextAlignment="Center"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Margin="0,8,0,0"
                                   FontSize="16" />
                        <TextBlock x:Name="WinnersLabel"
                                   TextAlignment="Center"
                                   Style="{StaticResource BodyTextBlockStyle}" />

                        <controls:ButtonEx x:Name="Button"
                                           Content="{CustomResource BoostingHowItWork}"
                                           Style="{StaticResource InstantViewButtonStyle}"
                                           Margin="0,12,0,4" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

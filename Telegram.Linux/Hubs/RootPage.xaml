<Page x:Class="Telegram.Views.Host.RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Telegram.Controls">

    <!--
        Linux RootPage: the Windows one (Telegram/Views/Host/RootPage.xaml) hosts the theme editor,
        an animated theme toggle and chooses its pane containers in ChoosingItemContainer, none of
        which Uno provides. Same element names where the code-behind uses them.
    -->

    <!-- Nothing else paints an opaque background: the pages Unigram hosts here are transparent by
         design (AuthorizationPage, ChatView...) because on Windows the default Page style fills it
         with this brush. Without it the window shows through and dark theme text lands on white. -->
    <Grid x:Name="LayoutRoot"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MainColumn" />
        </Grid.ColumnDefinitions>
        <SplitView x:Name="Navigation"
                   PaneOpening="Navigation_PaneOpening"
                   DisplayMode="Overlay"
                   BorderBrush="{ThemeResource NavigationViewItemSeparatorForeground}"
                   BorderThickness="0,0,1,0"
                   PaneBackground="{ThemeResource NavigationViewDefaultPaneBackground}"
                   OpenPaneLength="240"
                   IsTabStop="False">
            <SplitView.Pane>
                <ListView x:Name="NavigationViewList"
                          ItemClick="OnItemClick"
                          IsItemClickEnabled="True"
                          SelectionMode="None">
                    <ListView.Header>
                        <Button x:Name="Accounts"
                                Click="Expand_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="12,32,12,8"
                                IsTabStop="False">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:ProfilePicture x:Name="Photo"
                                                         Margin="0,0,12,0"
                                                         Size="48" />

                                <Grid x:Name="Info"
                                      Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="NameLabel"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Bottom"
                                               FontFamily="{ThemeResource EmojiThemeFontFamily}" />
                                    <TextBlock x:Name="PhoneLabel"
                                               VerticalAlignment="Top"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Grid.Row="1"
                                               MaxLines="1" />
                                </Grid>

                                <FontIcon x:Name="Expanded"
                                          FontFamily="{StaticResource SymbolThemeFontFamily}"
                                          Glyph="&#xE0E5;"
                                          FontSize="20"
                                          VerticalAlignment="Bottom"
                                          RenderTransformOrigin="0.5,0.5"
                                          Grid.Column="2">
                                    <FontIcon.RenderTransform>
                                        <RotateTransform x:Name="ExpandedRotation" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </Grid>
                        </Button>
                    </ListView.Header>
                </ListView>
            </SplitView.Pane>
        </SplitView>

        <Border x:Name="Transition" />
    </Grid>
</Page>

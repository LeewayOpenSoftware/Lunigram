<Project Sdk="Uno.Sdk">
  <!-- Generado por unigram-linux/tools/gen-linux-csproj.py a partir de fase1/files.json.
       Cabeza Linux de Unigram: Uno Platform (Skia/X11), net10.0. Los fuentes se enlazan desde ../Telegram. -->
  <Import Project="Version.props" />
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <RootNamespace>Telegram</RootNamespace>
    <AssemblyName>Unigram</AssemblyName>
    <ApplicationTitle>Unigram</ApplicationTitle>
    <ApplicationId>org.unigram.linux</ApplicationId>
    <!-- Version.props stays aligned with Telegram/Package.appxmanifest's Identity Version:
         on Windows the version at the foot of Settings comes from the package identity, which
         does not exist here, so VersionLabel.GetVersion reads the assembly instead. -->
    <ApplicationPublisher>unigram-linux</ApplicationPublisher>
    <UnoFeatures>SkiaRenderer;</UnoFeatures>

    <!-- Uno Hot Design fuera. No es una preferencia de estilo: `GlobalStaticResources.Initialize()`
         de Unigram (el generado, en obj/) llama a `Initialize()` + `RegisterDefaultStyles()` +
         `RegisterResourceDictionariesBySource()` de VEINTIDOS ensamblados, TRECE de ellos
         `Uno.UI.HotDesign.*`, y eso corre dentro del constructor de `App`, que es el tramo de
         3,15 s del informe de arranque. Solo cargarlos y resolver sus tipos cuesta 333 ms medidos
         (unigram-linux/spikes/StartupSpike) sobre un total de 702 ms para los veintidos; lo que
         luego hacen sus registros va encima. Son 14 MB de ensamblados que esta app no usa: el
         disenador visual necesita el dev-server de Uno, que aqui no se levanta.
         Release ya los excluye (`$(Optimize) == 'true'` en Uno.Implicit.Packages.ProjectSystem.targets),
         asi que esto solo cambia Debug, que es donde se desarrolla. -->
    <UnoDisableHotDesign>true</UnoDisableHotDesign>

    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <WarningLevel>1</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0105;CS0108;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS0067;CS1998;CS4014;CS8632;Uno0001;UXAML0001</NoWarn>
    <DefineConstants>$(DefineConstants);LINUX;TD_READER_PARSER</DefineConstants>
    <TdParsers>Reader</TdParsers>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Telegram.Generators\Telegram.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="..\Libraries\tdjson\td_api.tl" />
    <CompilerVisibleProperty Include="TdParsers" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Rg.DiffUtils" Version="1.0.0" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <!-- Desktop integration (fase 4): notificaciones fdo, contador del lanzador y bandeja SNI.
         Todo eso es D-Bus, y Tmds.DBus.Protocol es la unica pila D-Bus para .NET que ademas es
         compatible con NativeAOT (fase 7). Anotado en unigram-linux/HANDOFF.md como exige
         PORTING.md 4. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
  </ItemGroup>

  <!-- Recursos y assets de Unigram (ms-appx:///Assets/... se resuelve por el Link) -->
  <ItemGroup>
    <PRIResource Include="..\Telegram\Strings\en\Resources.resw" Link="Strings\en\Resources.resw" />
    <Content Include="..\Telegram\Assets\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
    <Content Include="..\Telegram\Assets\Emoji\*.ttf" Link="Assets\Emoji\%(Filename)%(Extension)" />
    <Content Include="..\Telegram\Assets\Images\**\*" Link="Assets\Images\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\Telegram\Assets\Logos\**\*" Link="Assets\Logos\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\Telegram\Assets\Animations\**\*" Link="Assets\Animations\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\Telegram\Assets\Background.tgv" Link="Assets\Background.tgv" />
    <!-- Los sonidos cortos (fase 5, paso 4): el tic al enviar, el aviso al recibir y los tonos
         de llamada. En Windows los abria SoundEffects con un ms-appx:///Assets/Audio/...; aqui
         los toca Telegram.Linux/Native/Media/SoundEffects.cs con un handle de libmpv de usar y
         tirar, y la ruta la resuelve NativeAssets a partir de AppContext.BaseDirectory. -->
    <Content Include="..\Telegram\Assets\Audio\*.mp3" Link="Assets\Audio\%(Filename)%(Extension)" />
    <!-- Ficheros de datos de los motores nativos. En Windows el empaquetado los dejaba en
         Assets\ y Telegram.Native los abria con una ruta RELATIVA al paquete; aqui no hay
         paquete y el directorio de trabajo no es el de la app, asi que la ruta la resuelve
         Telegram.Linux/Native/NativeAssets.cs a partir de AppContext.BaseDirectory. Lo unico
         que hace falta de este lado es que los dos ficheros esten en bin/.../Assets/.
         grammars.dat vive en Libraries/ (no en Telegram/Assets), igual que en el repo. -->
    <!-- Los tres iconos del tray, los MISMOS que usa el proceso auxiliar de Windows
         (Telegram.Stub/Resources): logo, logo con punto gris (no leidos silenciados) y logo con
         punto rojo. Los lee Platform/DBus/TrayIcons.cs por NativeAssets.Resolve. -->
    <Content Include="..\Telegram.Stub\Resources\Default.ico" Link="Assets\TrayDefault.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Telegram.Stub\Resources\Muted.ico" Link="Assets\TrayMuted.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Telegram.Stub\Resources\Unmuted.ico" Link="Assets\TrayUnmuted.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Telegram\Assets\langid_model.smfb.jpg" Link="Assets\langid_model.smfb.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Libraries\libprisma\libprisma\grammars.dat" Link="Assets\grammars.dat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- TDLib parcheada (compilada en la Mint, ver unigram-linux/native/tdlib): junto al binario.
       Ambos nombres se copian a proposito: NativeLibraryResolver.cs prueba primero el nombre sin
       version ("libtdjson.so") y cae a la version con SONAME ("libtdjson.so.1.8.67") si falta. Antes
       solo el primero estaba aqui — el segundo estaba colocado a mano en cada bundle y ningun build
       lo mantenia, asi que un layout que solo llevara la version con SONAME se habria roto en
       silencio. CopyToOutputDirectory="PreserveNewest" solo evita una copia mas nueva; NO reconstruye
       out/ si su contenido queda desactualizado respecto al SONAME que el resolver espera — out/ debe
       mantenerse en sync manualmente (ver unigram-linux/native/tdlib/build-tdjson.sh).
       Condition=Exists, igual que los otros motores nativos de abajo: la ruta relativa solo resuelve
       cuando unigram-linux es hermano del padre del worktree (cierto para todo worktree bajo
       ~/Documentos/CODE por convencion, falso para uno disponible en otra parte, p.ej. un scratch
       dir). Sin el Condition, un worktree fuera de esa convencion fallaba con MSB3030 al copiar
       ("no se encontró", sin explicar por que) aunque el C# compilara con 0 errores; el resolver ya
       acepta TDJSON_PATH como alternativa quien construya asi.
       OJO al leer un build verde desde fuera de esa convencion: Condition=Exists convierte el fallo
       de compilacion (ruidoso, se nota al momento) en una ausencia silenciosa en tiempo de ejecucion
       (el .so simplemente no esta en la salida) — compila 0/0 pero el binario resultante no arranca
       sin TDJSON_PATH. El Target de abajo devuelve parte de ese ruido: sin el, lo unico que se ve es
       un DllNotFoundException por "tdjson.dll" (el nombre Windows del P/Invoke) al arrancar, que no
       menciona libtdjson.so ni TDJSON_PATH en ningun sitio. -->
  <ItemGroup>
    <None Include="..\..\unigram-linux\native\tdlib\out\libtdjson.so" Link="libtdjson.so" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\..\unigram-linux\native\tdlib\out\libtdjson.so')" />
    <None Include="..\..\unigram-linux\native\tdlib\out\libtdjson.so.1.8.67" Link="libtdjson.so.1.8.67" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\..\unigram-linux\native\tdlib\out\libtdjson.so.1.8.67')" />
  </ItemGroup>

  <!-- GL-2 (clean-clone buildability). Three inputs this project needs are NOT in a fresh
       clone: two are gitignored on purpose and one lives in a submodule. Without these checks
       a new contributor gets CS2001 "source file not found" or MSB3030 "could not copy",
       neither of which says what to create or which command to run. See BUILDING-LINUX.md. -->
  <Target Name="CheckBuildPrerequisites" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\Telegram\Constants.Secret.cs')"
           Text="Telegram/Constants.Secret.cs is missing. It is gitignored on purpose: it carries YOUR OWN api_id/api_hash. Copy Telegram/Constants.Secret.cs.template over it and fill in credentials from https://my.telegram.org/apps. Step 2 of BUILDING-LINUX.md." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\Libraries\tdjson\td_api.tl')"
           Text="Libraries/tdjson/td_api.tl is missing. Copy it out of the tdlib submodule: mkdir -p Libraries/tdjson &amp;&amp; cp Libraries/tdlib/td/generate/scheme/td_api.tl Libraries/tdjson/td_api.tl  (run `git submodule update --init --recursive` first). Step 3 of BUILDING-LINUX.md." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\Libraries\libprisma\libprisma\grammars.dat')"
           Text="Libraries/libprisma/libprisma/grammars.dat is missing, which means the submodules are not checked out. Run: git submodule update --init --recursive. Step 1 of BUILDING-LINUX.md." />
  </Target>

  <!-- The scheme in Libraries/tdjson must match the tdlib submodule the natives are built from.
       This is not pedantry: a submodule left at an OLDER commit than the recorded gitlink hands
       you a valid-looking td_api.tl that generates the wrong TD bindings, and the build then
       fails with dozens of CS0117 / CS1739 / CS1729 spread across ordinary application files,
       none of which mentions td_api.tl. Measured, not hypothetical: the scheme at 022d6020
       produces 58 such errors against this source, where the recorded bc9c263e produces zero.
       A warning, not an error, because building against a deliberately different TDLib is a
       legitimate thing to do — it just has to be deliberate. -->
  <Target Name="CheckTdApiSchemeMatchesSubmodule" BeforeTargets="Build"
          Condition="Exists('$(MSBuildThisFileDirectory)..\Libraries\tdjson\td_api.tl') And Exists('$(MSBuildThisFileDirectory)..\Libraries\tdlib\td\generate\scheme\td_api.tl')">
    <GetFileHash Files="$(MSBuildThisFileDirectory)..\Libraries\tdjson\td_api.tl" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_TdApiInUse" />
    </GetFileHash>
    <GetFileHash Files="$(MSBuildThisFileDirectory)..\Libraries\tdlib\td\generate\scheme\td_api.tl" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_TdApiInSubmodule" />
    </GetFileHash>
    <Warning Condition="'%(_TdApiInUse.FileHash)' != '@(_TdApiInSubmodule->'%(FileHash)')'"
             Text="Libraries/tdjson/td_api.tl does NOT match Libraries/tdlib/td/generate/scheme/td_api.tl. If that is not deliberate, your submodule is at the wrong commit or the copy is stale: git submodule update --init --recursive, then re-copy the scheme. See BUILDING-LINUX.md." />
  </Target>

  <Target Name="WarnMissingTdjson" BeforeTargets="Build">
    <Warning Condition="!Exists('..\..\unigram-linux\native\tdlib\out\libtdjson.so')"
             Text="libtdjson.so no encontrado en ..\..\unigram-linux\native\tdlib\out (worktree fuera de la convencion ~/Documentos/CODE): se omite la copia. El build sera verde pero la app no arrancara salvo que TDJSON_PATH apunte a un build de TDLib." />
  </Target>

  <!-- Motores nativos (unigram-linux/native): libunigram-native.so es la ABI C sobre rlottie y
       compania; librlottie.so se copia con su SONAME (librlottie.so.0) porque es lo que el enlazador
       dinamico busca al cargar libunigram-native.so. Condition=Exists: se compilan en la Mint y
       pueden no estar todavia; el resolver de Native/NativeLibraryResolver.cs tambien acepta
       UNIGRAM_NATIVE_PATH mientras se desarrolla. -->
  <ItemGroup>
    <None Include="..\..\unigram-linux\native\unigram-native\out\lib\libunigram-native.so" Link="libunigram-native.so" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\..\unigram-linux\native\unigram-native\out\lib\libunigram-native.so')" />
    <None Include="..\..\unigram-linux\native\rlottie\out\librlottie.so.0.2" Link="librlottie.so.0" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\..\unigram-linux\native\rlottie\out\librlottie.so.0.2')" />
    <!-- libunigram-calls.so: la ABI C sobre tgcalls (llamadas y video). NO estaba aqui, y esa
         ausencia es la razon de que bin/ no la haya tenido nunca: el resolver la busca en
         AppContext.BaseDirectory (Native/NativeLibraryResolver.cs), o sea justo en bin/, asi que
         sin esta linea las llamadas no podian cargarse desde una compilacion limpia. Se coloco a
         mano en la consolidacion #3 (u-043) y sobrevivia a un build normal pero no a un
         rm -rf bin. Misma forma que las dos de arriba, Condition=Exists incluida, porque esta
         .so son 30 MB de tg_owt que no siempre estan construidos. -->
    <None Include="..\..\unigram-linux\native\calls\out\lib\libunigram-calls.so" Link="libunigram-calls.so" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\..\unigram-linux\native\calls\out\lib\libunigram-calls.so')" />
    <!-- FFmpeg NO se copia: entra ESTATICO dentro de libunigram-native.so (FFmpeg 7.1.2 propio,
         minimo, con los codecs que habilita Libraries/vcpkg-ports/ffmpeg/portfile.cmake; lo
         compila unigram-linux/native/ffmpeg/build-ffmpeg.sh). Antes se copiaban 21 .so / 90 MB
         del FFmpeg de Ubuntu porque el SONAME lleva la version mayor y la .so compilada en la
         Mint (libavcodec.so.60) no cargaba en la SP4 (62), y al no cargar se caia la .so
         entera, lottie incluido. Con FFmpeg dentro no hay SONAME que casar ni nada que copiar. -->
  </ItemGroup>

